# Claude Code local settings (machine-specific, not for sharing)
.claude/settings.local.json

# tmux plugin manager — plugins are installed at runtime, not tracked
.tmux/plugins/

# wallust-generated palettes (machine-specific, overwritten on wallpaper change)
waybar/generated-colors.css
rofi/generated-colors.rasi
swaync/generated-colors.css
kitty/generated-colors.conf
alacritty/generated-colors.toml
firefox/generated-colors.css
quickshell/generated-colors.json

# matugen-generated GTK palette. It is written to ~/.config/gtk-3.0/colors.css,
# which is outside the repo, so there is normally nothing to ignore — these entries
# are defensive, in case the whole gtk/ dir is ever symlinked instead of just gtk.css.
# The template (matugen/templates/breeze.css) and the consumer (gtk/gtk-3.0/gtk.css)
# ARE tracked; only the generated output is machine-specific.
gtk/gtk-3.0/colors.css
gtk/gtk-4.0/colors.css

# waypaper rewrites config.ini in full on every wallpaper change, so tracking it
# means a dirty tree after every pick. The settings that matter live in
# config.ini.template, which install.sh seeds into place. waypaper's own state
# file (~/.local/state/waypaper/state.ini, via use_xdg_state = True) carries the
# volatile wallpaper/backend/folder values, so this file stays stable.
waypaper/config.ini

# opencode's service password, generated per machine by the background service.
# install.sh symlinks opencode.json and cli.json individually and deliberately
# leaves this file in ~/.config/opencode, so it should never reach the repo —
# the entry is defensive in case the whole opencode/ dir is ever linked instead.
opencode/service.json
