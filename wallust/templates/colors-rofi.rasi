/* Generated by wallust — do not edit (overwritten on wallpaper change).
 * Redefines the palette vars from rofi/config.rasi (later definitions win). */
* {
    base:       {{background}};
    mantle:     {{color0}};
    bg-window:  {{background}}E0;
    bg-input:   {{color0}}F0;
    crust:      {{color0}};
    surface0:   {{color8}};
    surface1:   {{color8}};
    overlay0:   {{color8}};
    subtext0:   {{color7}};
    text:       {{foreground}};

    blue:       {{color4}};
    mauve:      {{color5}};
    red:        {{color1}};
    peach:      {{color11}};
    green:      {{color2}};
    teal:       {{color6}};
}
